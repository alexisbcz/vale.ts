{
	"$schema": "https://biomejs.dev/schemas/2.0.0/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**/*.ts",
			"**/*.json",
			"!**/node_modules",
			"!**/dist",
			"!**/test/fixtures",
			"!tests/compat/.cache",
			"!packages/models/data"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 84
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"style": {
				"noNonNullAssertion": "off",
				"useNamingConvention": "off",
				"noParameterAssign": "off"
			},
			"complexity": {
				"noExcessiveCognitiveComplexity": "off",
				"useLiteralKeys": "off",
				"noUselessStringRaw": "off"
			},
			"suspicious": {
				"noExplicitAny": "warn",
				"noTemplateCurlyInString": "off"
			},
			"performance": {
				"noAccumulatingSpread": "off"
			},
			"correctness": {
				"noPrecisionLoss": "warn"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"trailingCommas": "all",
			"semicolons": "always",
			"arrowParentheses": "always"
		}
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
