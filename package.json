{
  "name": "vale-ts-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.2.0"
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "test": "bun test packages",
    "test:compat": "bun tests/compat/run.ts",
    "compat:fetch": "bun tests/compat/fetch.ts --reference",
    "typecheck": "bun run scripts/typecheck.ts",
    "lint": "biome check .",
    "fmt": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/bun": "latest",
    "@types/markdown-it": "14.1.2",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "css-select": "5.2.2",
    "dom-serializer": "2.0.0",
    "domhandler": "5.0.3",
    "domutils": "3.2.2",
    "entities": "6.0.1",
    "markdown-it": "14.1.0",
    "markdown-it-footnote": "4.0.0",
    "markdown-it-task-lists": "2.1.1",
    "parse5": "7.3.0",
    "parse5-htmlparser2-tree-adapter": "7.1.0",
    "smol-toml": "1.5.0",
    "yaml": "2.8.1"
  }
}
