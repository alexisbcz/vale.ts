{
	"name": "@vale-ts/cli",
	"version": "0.1.0",
	"description": "The vale-ts command-line interface.",
	"license": "MIT",
	"author": "Alexis Bouchez",
	"homepage": "https://github.com/alexisbcz/vale.ts/tree/main/packages/cli",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/alexisbcz/vale.ts.git",
		"directory": "packages/cli"
	},
	"bugs": {
		"url": "https://github.com/alexisbcz/vale.ts/issues"
	},
	"keywords": [
		"vale",
		"prose",
		"linter",
		"cli",
		"writing",
		"markdown",
		"docs"
	],
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"bun": "./src/index.ts",
			"default": "./dist/index.js"
		}
	},
	"bin": {
		"vale-ts": "./src/main.ts"
	},
	"files": [
		"src",
		"dist",
		"data",
		"THIRD_PARTY_NOTICES.md"
	],
	"dependencies": {
		"@vale-ts/check": "workspace:*",
		"@vale-ts/core": "workspace:*",
		"@vale-ts/lint": "workspace:*",
		"@vale-ts/nlp": "workspace:*",
		"fflate": "^0.8.3",
		"vale-ts": "workspace:*"
	},
	"publishConfig": {
		"main": "./dist/index.js",
		"types": "./dist/index.d.ts",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"import": "./dist/index.js"
			}
		},
		"bin": {
			"vale-ts": "./dist/main.js"
		}
	}
}
