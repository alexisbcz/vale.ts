{
  "name": "@vale-ts/cli",
  "version": "0.1.0",
  "description": "The vale-ts command-line interface.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "vale-ts": "./src/main.ts"
  },
  "files": [
    "src",
    "dist",
    "data"
  ],
  "dependencies": {
    "@vale-ts/check": "workspace:*",
    "@vale-ts/core": "workspace:*",
    "@vale-ts/lint": "workspace:*",
    "fflate": "^0.8.3",
    "vale-ts": "workspace:*"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  }
}
