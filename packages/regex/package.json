{
	"name": "@vale-ts/regex",
	"version": "0.1.0",
	"description": "Translates .NET/RE2-flavored regular expressions (as used by Vale rules) to native JavaScript RegExp, plus a literal prefilter.",
	"license": "MIT",
	"author": "Alexis Bouchez",
	"homepage": "https://github.com/alexisbcz/vale.ts/tree/main/packages/regex",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/alexisbcz/vale.ts.git",
		"directory": "packages/regex"
	},
	"bugs": {
		"url": "https://github.com/alexisbcz/vale.ts/issues"
	},
	"keywords": [
		"regex",
		"re2",
		"dotnet",
		"vale"
	],
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"bun": "./src/index.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"src",
		"dist",
		"THIRD_PARTY_NOTICES.md"
	],
	"publishConfig": {
		"main": "./dist/index.js",
		"types": "./dist/index.d.ts",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"import": "./dist/index.js"
			}
		}
	}
}
