{
  "name": "@vale-ts/regex",
  "version": "0.1.0",
  "description": "Translates .NET/RE2-flavored regular expressions (as used by Vale rules) to native JavaScript RegExp, plus a literal prefilter.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "dist"
  ],
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  }
}
