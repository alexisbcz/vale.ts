{
  "name": "@vale-ts/core",
  "version": "0.1.0",
  "description": "Vale's configuration model, alert types, file model and location arithmetic.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "dist"
  ],
  "dependencies": {
    "@vale-ts/nlp": "workspace:*",
    "@vale-ts/regex": "workspace:*",
    "smol-toml": "1.5.0",
    "yaml": "2.8.1"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  }
}
