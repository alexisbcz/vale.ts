{
	"name": "@vale-ts/check",
	"version": "0.1.0",
	"description": "Vale's rule types -- existence, substitution, occurrence, and the rest -- and the scope selectors they run in.",
	"license": "MIT",
	"author": "Alexis Bouchez",
	"homepage": "https://github.com/alexisbcz/vale.ts/tree/main/packages/check",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/alexisbcz/vale.ts.git",
		"directory": "packages/check"
	},
	"bugs": {
		"url": "https://github.com/alexisbcz/vale.ts/issues"
	},
	"keywords": [
		"vale",
		"prose",
		"linter",
		"rules"
	],
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"bun": "./src/index.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"src",
		"dist",
		"data",
		"THIRD_PARTY_NOTICES.md"
	],
	"dependencies": {
		"@vale-ts/core": "workspace:*",
		"@vale-ts/nlp": "workspace:*",
		"@vale-ts/regex": "workspace:*",
		"@vale-ts/spell": "workspace:*",
		"@vale-ts/tengo": "workspace:*",
		"css-select": "5.2.2",
		"yaml": "2.8.1"
	},
	"publishConfig": {
		"main": "./dist/index.js",
		"types": "./dist/index.d.ts",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"import": "./dist/index.js"
			}
		}
	}
}
