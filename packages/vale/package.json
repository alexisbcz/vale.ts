{
	"name": "vale-ts",
	"version": "0.1.0",
	"description": "Vale, the syntax-aware prose linter, as a TypeScript library.",
	"keywords": [
		"vale",
		"prose",
		"linter",
		"writing",
		"style",
		"markdown",
		"docs"
	],
	"license": "MIT",
	"author": "Alexis Bouchez",
	"homepage": "https://github.com/alexisbcz/vale.ts#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/alexisbcz/vale.ts.git",
		"directory": "packages/vale"
	},
	"bugs": {
		"url": "https://github.com/alexisbcz/vale.ts/issues"
	},
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"bun": "./src/index.ts",
			"default": "./dist/index.js"
		}
	},
	"publishConfig": {
		"main": "./dist/index.js",
		"types": "./dist/index.d.ts",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"import": "./dist/index.js"
			}
		}
	},
	"files": [
		"src",
		"dist",
		"THIRD_PARTY_NOTICES.md"
	],
	"dependencies": {
		"@vale-ts/check": "workspace:*",
		"@vale-ts/core": "workspace:*",
		"@vale-ts/lint": "workspace:*",
		"@vale-ts/spell": "workspace:*"
	}
}
