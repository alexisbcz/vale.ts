{
	"name": "@vale-ts/tengo",
	"version": "0.1.0",
	"description": "An interpreter for the Tengo subset Vale's script rules, metric formulas and suggest actions are written in.",
	"license": "MIT",
	"author": "Alexis Bouchez",
	"homepage": "https://github.com/alexisbcz/vale.ts/tree/main/packages/tengo",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/alexisbcz/vale.ts.git",
		"directory": "packages/tengo"
	},
	"bugs": {
		"url": "https://github.com/alexisbcz/vale.ts/issues"
	},
	"keywords": [
		"tengo",
		"interpreter",
		"vale"
	],
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"bun": "./src/index.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"src",
		"dist",
		"THIRD_PARTY_NOTICES.md"
	],
	"dependencies": {
		"@vale-ts/regex": "workspace:*"
	},
	"publishConfig": {
		"main": "./dist/index.js",
		"types": "./dist/index.d.ts",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"import": "./dist/index.js",
				"default": "./dist/index.js"
			}
		}
	}
}
